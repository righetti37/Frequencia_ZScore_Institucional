import MetaTrader5 as mt5
import pandas as pd
import numpy as np
import plotly.graph_objects as go

# ====================================================================
#  INPUTS DO USUÁRIO (Configure aqui os parâmetros )
# ====================================================================
USER_INPUTS = {
    "symbol": "EURUSD",           # Ativo (Ex: EURUSD, NAS100, AAPL, WIN$, BTCUSD)
    "timeframe": "M15",           # Tempo Gráfico (M1, M5, M15, M30, H1, H4, D1)
    "period_mm": 200,             # Período da MME (EMA)
    "period_z": 200,              # Período do Z-Score
    "count": 1000,                # Quantidade de candles históricos para o gráfico
    
    # Níveis de Alerta (Extremos de Reversão)
    "level_ext_pos": 2.5,         # Extremo de Venda
    "level_ext_neg": -2.5,        # Extremo de Compra
    "level_alert_pos": 1.5,       # Alerta de Venda Moderada
    "level_alert_neg": -1.5,      # Alerta de Compra Moderada
    
    # Cores (Estética Premium)
    "color_venda_ext": "red",
    "color_venda": "orangered",
    "color_neutro": "gray",
    "color_compra": "springgreen",
    "color_compra_ext": "lime"
}

# Mapeamento interno de Timeframes
TF_MAP = {
    "M1": mt5.TIMEFRAME_M1, "M5": mt5.TIMEFRAME_M5, "M15": mt5.TIMEFRAME_M15,
    "M30": mt5.TIMEFRAME_M30, "H1": mt5.TIMEFRAME_H1, "H4": mt5.TIMEFRAME_H4,
    "D1": mt5.TIMEFRAME_D1, "W1": mt5.TIMEFRAME_W1
}

def get_mt5_data(symbol, tf_str, count):
    if not mt5.initialize():
        print("❌ Erro: MetaTrader 5 não encontrado.")
        return None
    
    timeframe = TF_MAP.get(tf_str, mt5.TIMEFRAME_M15)
    rates = mt5.copy_rates_from_pos(symbol, timeframe, 0, count)
    mt5.shutdown()
    
    if rates is None or len(rates) == 0:
        print(f"❌ Erro: Não foi possível obter dados para {symbol}.")
        return None
        
    df = pd.DataFrame(rates)
    df['time'] = pd.to_datetime(df['time'], unit='s')
    df.set_index('time', inplace=True)
    return df

def calculate_zscore_premium(df, period_mm, period_z):
    # Cálculo idêntico ao robô MQL5
    df['EMA'] = df['close'].ewm(span=period_mm, adjust=False).mean()
    df['diff_sq'] = (df['close'] - df['EMA'])**2
    df['dynamic_std'] = np.sqrt(df['diff_sq'].rolling(window=period_z).mean())
    df['zscore'] = (df['close'] - df['EMA']) / df['dynamic_std']
    return df

def plot_premium(df, inputs):
    def get_color(z):
        if z <= inputs["level_ext_neg"]: return inputs["color_compra_ext"]
        if z <= inputs["level_alert_neg"]: return inputs["color_compra"]
        if z >= inputs["level_ext_pos"]: return inputs["color_venda_ext"]
        if z >= inputs["level_alert_pos"]: return inputs["color_venda"]
        return inputs["color_neutro"]

    df['color'] = df['zscore'].apply(get_color)
    
    fig = go.Figure()
    fig.add_trace(go.Bar(x=df.index, y=df['zscore'], marker_color=df['color'], name='Z-Score'))
    fig.add_trace(go.Scatter(x=df.index, y=df['zscore'], mode='lines', line=dict(color='white', width=1), name='Linha'))

    for lvl in [inputs["level_ext_pos"], 0, inputs["level_ext_neg"]]:
        fig.add_hline(y=lvl, line_dash="dot", line_color="rgba(255,255,255,0.3)")

    fig.update_layout(
        title=f'Z-Score Premium v3 Universal - {inputs["symbol"]} ({inputs["timeframe"]})  
<sup>Diego Vinicius Righetti Sá | Frequência do Mercado</sup>',
        template='plotly_dark',
        yaxis=dict(range=[-5, 5], title='Z-Score'),
        xaxis_title='Data/Hora',
        plot_bgcolor='black', paper_bgcolor='black'
    )
    return fig

if __name__ == "__main__":
    data = get_mt5_data(USER_INPUTS["symbol"], USER_INPUTS["timeframe"], USER_INPUTS["count"])
    if data is not None:
        df_final = calculate_zscore_premium(data, USER_INPUTS["period_mm"], USER_INPUTS["period_z"])
        fig = plot_premium(df_final, USER_INPUTS)
        fig.show()
        print(f"✅ Análise de {USER_INPUTS['symbol']} concluída com sucesso!")
